# Synthetic developer service only. This is not the Android privacy runtime.
# scripts/dev.ps1 uses this template directly; copying to .env is unnecessary.
# Do not add private media, credentials, or household records to this service.
KNOCK_KNOCK_ENVIRONMENT=synthetic-development
KNOCK_KNOCK_LOG_LEVEL=WARNING
KNOCK_KNOCK_CAMERA_BACKEND=simulator
KNOCK_KNOCK_VISION_BACKEND=stub
KNOCK_KNOCK_SIMULATOR_IMAGE_PATH=fixtures/synthetic/door.jpg
KNOCK_KNOCK_FIXTURE_MANIFEST_PATH=fixtures/manifests/group-arrival.json
KNOCK_KNOCK_PROFILE_CONFIG_PATH=.runtime/synthetic/profiles.yaml
KNOCK_KNOCK_VISITOR_LOG_PATH=.runtime/synthetic/visitors.jsonl
KNOCK_KNOCK_SHARED_STATE_PATH=.runtime/synthetic/household.json
KNOCK_KNOCK_FACE_DATASET_DIR=.runtime/synthetic/faces
# Override inherited deployed/cloud settings to isolate the synthetic harness.
KNOCK_KNOCK_RING_ACCESS_TOKEN=
KNOCK_KNOCK_RING_REFRESH_TOKEN=
KNOCK_KNOCK_RING_ACCOUNT_ID=
KNOCK_KNOCK_RING_CLIENT_ID=
KNOCK_KNOCK_RING_CLIENT_SECRET=
KNOCK_KNOCK_RING_HMAC_SIGNING_KEY=
KNOCK_KNOCK_RING_SECRET_ARN=
KNOCK_KNOCK_FIREBASE_SECRET_ARN=
KNOCK_KNOCK_EVENT_QUEUE_URL=
KNOCK_KNOCK_EVENT_LEDGER_TABLE=
KNOCK_KNOCK_VISIT_TABLE=
KNOCK_KNOCK_HOUSEHOLD_TABLE=
KNOCK_KNOCK_MEDIA_BUCKET=
