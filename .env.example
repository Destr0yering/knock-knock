# Copy to .env. Never commit the real .env file.
KNOCK_KNOCK_ENVIRONMENT=development
KNOCK_KNOCK_LOG_LEVEL=INFO

# Use "simulator" until Ring Partner API credentials and a public HTTPS webhook exist.
KNOCK_KNOCK_CAMERA_BACKEND=simulator
KNOCK_KNOCK_SIMULATOR_IMAGE_PATH=data/simulator/door.jpg
KNOCK_KNOCK_FIXTURE_MANIFEST_PATH=fixtures/manifests/group-arrival.json

# Ring Partner API credentials. Obtain these in the Amazon Developer Portal.
KNOCK_KNOCK_RING_API_BASE_URL=https://api.amazonvision.com
KNOCK_KNOCK_RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
KNOCK_KNOCK_RING_CLIENT_ID=
KNOCK_KNOCK_RING_CLIENT_SECRET=
KNOCK_KNOCK_RING_HMAC_SIGNING_KEY=

# Development-only shortcut. Production must use per-account OAuth tokens in a secret store.
KNOCK_KNOCK_RING_ACCESS_TOKEN=
KNOCK_KNOCK_RING_REFRESH_TOKEN=
KNOCK_KNOCK_RING_ACCOUNT_ID=

# "opencv", "aws", or "stub". Stub is deterministic and useful for API smoke tests.
KNOCK_KNOCK_VISION_BACKEND=opencv
KNOCK_KNOCK_FACE_MATCH_THRESHOLD=0.62
KNOCK_KNOCK_FACE_DATASET_DIR=data/faces

# AWS Rekognition backend (only required when VISION_BACKEND=aws).
KNOCK_KNOCK_AWS_REGION=us-east-1
KNOCK_KNOCK_AWS_REKOGNITION_COLLECTION_ID=knock-knock-faces

# Local private application state.
KNOCK_KNOCK_PROFILE_CONFIG_PATH=config/known_faces.yaml
KNOCK_KNOCK_VISITOR_LOG_PATH=data/visitors.jsonl
KNOCK_KNOCK_SHARED_STATE_PATH=data/household-state.json

